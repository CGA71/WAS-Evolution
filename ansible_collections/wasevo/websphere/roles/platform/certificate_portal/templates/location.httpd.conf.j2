# {{ ansible_managed }}
# The certificate portal, on AWX's host name, for Apache httpd or IBM HTTP
# Server (mod_alias and mod_headers). Include this file in the virtual host
# that serves {{ _certportal_host }}, then reload the server. If that virtual
# host proxies / to AWX, exclude this path first:
#   ProxyPass {{ certportal_path }} !
RedirectMatch 301 ^{{ certportal_path }}$ {{ certportal_path }}/
Alias {{ certportal_path }}/ "{{ certportal_web_root }}/"
<Directory "{{ certportal_web_root }}">
    Options -Indexes
    DirectoryIndex index.html
    Require all granted
    Header set Cache-Control "no-cache"
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "same-origin"
    Header set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
</Directory>
