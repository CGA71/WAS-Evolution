# {{ ansible_managed }}
# The application portal, on AWX's host name. Include this file inside the
# server block that serves {{ _appportal_host }}, then reload nginx. Only this
# path is served from disk; everything else on the host still reaches AWX.
location = {{ appportal_path }} { return 301 {{ appportal_path }}/; }
location {{ appportal_path }}/ {
    alias {{ appportal_web_root }}/;
    index index.html;
    autoindex off;
    add_header Cache-Control "no-cache";
    add_header X-Content-Type-Options "nosniff";
    add_header Referrer-Policy "same-origin";
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'";
}
