# Generated by wasevo.websphere.liberty.config_render - do not edit by hand.
#
# Target : {{ runtime.product }} / Java {{ runtime.jdk.version }} {{ runtime.jdk.vm }}
#
# On the traditional plane these were liste_jvm_extended_property entries set
# through wsadmin. On Liberty they are environment variables, and this is where
# they land.
#
# NO SECRET IS RENDERED INTO THIS FILE FROM THE MODEL. Values that carry a
# credential are listed by name only; they are injected at deploy time from an
# AAP Credential or, on OpenShift, from a Secret mounted by the operator.

WLP_SKIP_MAXPERMSIZE=true

{% if runtime.jdk.vm in ['j9', 'openj9'] %}
{% if jvm_env.heapdump_dir is defined %}
IBM_HEAPDUMPDIR={{ jvm_env.heapdump_dir }}
{% endif %}
{% if jvm_env.javacore_dir is defined %}
IBM_JAVACOREDIR={{ jvm_env.javacore_dir }}
{% endif %}
{% if jvm_env.core_dir is defined %}
IBM_COREDIR={{ jvm_env.core_dir }}
{% endif %}
{% if jvm_env.dump_on_oom | default(false) %}
IBM_HEAPDUMP_OUTOFMEMORY=true
IBM_JAVADUMP_OUTOFMEMORY=true
{% endif %}
{% endif %}
{% if runtime.product == 'liberty_ocp' %}

# In a pod, a dump written to the container filesystem dies with the pod.
# Either the directories above point at a PersistentVolume, or dumps are taken
# through the operator WebSphereLibertyDump custom resource instead. Pick one
# deliberately; silently losing dumps is the failure mode here.
{% endif %}
{% for name in secret_env_names | default([]) %}
# {{ name }} is injected at deploy time, not rendered here.
{% endfor %}
