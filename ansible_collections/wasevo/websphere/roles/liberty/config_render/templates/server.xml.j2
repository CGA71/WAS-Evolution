{{ '<?xml version="1.0" encoding="UTF-8"?>' }}
<!--
  Generated by wasevo.websphere.liberty.config_render - do not edit by hand.
  Source model : {{ model_source | default('model/') }}
  Target       : {{ runtime.product }} / Java {{ runtime.jdk.version }} {{ runtime.jdk.vm }}
  Generated    : {{ ansible_date_time.iso8601 | default('n/a') }}
-->
<server description="{{ server_description | default(server_name) }}">

  <!-- Features are declared explicitly rather than relying on a `full` image.
       The feature level and the Java level are coupled: javaee-8.0 on Semeru 21
       is the assumption holding up phase 2 for category A applications, and it
       is the open verification point in README section 9. -->
  <featureManager>
{% for feature in liberty_features %}
    <feature>{{ feature }}</feature>
{% endfor %}
  </featureManager>

  <httpEndpoint id="defaultHttpEndpoint"
                host="{{ liberty_http_host | default('*') }}"
                httpPort="{{ liberty_http_port | default(9080) }}"
                httpsPort="{{ liberty_https_port | default(9443) }}" />

{% if liberty_session_cache | default(false) %}
  <!-- WAS ND replicated sessions through DRS. Liberty has no DRS: the
       equivalent is a JCache provider, or sticky routing at the Route. -->
  <httpSessionCache libraryRef="{{ liberty_session_cache_library }}" />
{% endif %}

{% if 'monitor-1.0' in liberty_features %}
  <!-- PMI does not exist on Liberty. This is its replacement, and it has to be
       in place from wave 3 onwards, not deferred to phase 3. -->
  <monitor filter="{{ liberty_monitor_filter | default('WebContainer,ThreadPool,Session,ConnectionPool,JVM') }}" />
{% endif %}

{% for app in applications | default([]) %}
  <application id="{{ app.name }}"
               name="{{ app.name }}"
               location="{{ app.location }}"
               type="{{ app.type | default('war') }}">
{% if app.context_root is defined %}
    <web-ext context-root="{{ app.context_root }}" />
{% endif %}
  </application>
{% endfor %}

{# A library is a directory and a pattern, or an explicit list of jars - the
   same two forms the traditional back-end renders, so one declaration means
   the same class path on both. #}
{% for lib in shared_libraries | default([]) %}
  <library id="{{ lib.name }}">
{% if lib.jars is defined %}
{% for jar in lib.jars %}
    <file name="{{ jar }}" />
{% endfor %}
{% else %}
    <fileset dir="{{ lib.dir }}" includes="{{ lib.includes | default('*.jar') }}" />
{% endif %}
  </library>
{% endfor %}

  <!-- Everything model-driven that can live in a fragment does, so that a
       change to one resource does not rewrite this file. -->
  <include optional="true" location="${server.config.dir}/configDropins/overrides/" />

</server>
