{{ '<?xml version="1.0" encoding="UTF-8"?>' }}
<!--
  Generated by wasevo.websphere.liberty.config_render - do not edit by hand.

  This fragment is the proof of layer 1. The datasources below are declared
  ONCE in the shared model. The traditional back-end turns the same
  declarations into was_datasource module arguments passed to wsadmin; this
  back-end turns them into Liberty XML. Nothing in the model knows which
  back-end will consume it.
-->
<server>

{% for ds in datasources %}
  <jdbcDriver id="{{ ds.name }}-driver" libraryRef="{{ ds.name }}-lib" />

  <library id="{{ ds.name }}-lib">
    <fileset dir="{{ ds.driver_dir }}" includes="{{ ds.driver_jar }}" />
  </library>

  <dataSource id="{{ ds.name }}"
              jndiName="{{ ds.jndi_name }}"
              jdbcDriverRef="{{ ds.name }}-driver"
{% if ds.auth_alias is defined %}
              containerAuthDataRef="{{ ds.auth_alias }}"
{% endif %}
              transactional="{{ ds.transactional | default('true') }}"
              statementCacheSize="{{ ds.statement_cache_size | default(10) }}">

    <properties{{ '.' ~ ds.vendor if ds.vendor is defined else '' }}
{% for key, value in ds.properties.items() %}
                {{ key }}="{{ value }}"
{% endfor %}
                />

    <connectionManager
{% if ds.pool is defined %}
{% for key, value in ds.pool.items() %}
        {{ key }}="{{ value }}"
{% endfor %}
{% endif %}
        />
  </dataSource>

{% endfor %}

{% for alias in j2c_aliases | default([]) %}
  <!-- The password is substituted from server.env, which is itself rendered
       from an AAP Credential. It is never written into a versioned file. -->
  <authData id="{{ alias.name }}"
            user="{{ alias.user }}"
            password="${env.{{ alias.password_env }}}" />
{% endfor %}

</server>
