{#
  manageprofiles response file for a federated node - the node agent and the
  node the cluster members are created on. IBM's format: mode on the first
  line, then key=value, no dashes, no quoting.

  Federating during creation rather than creating and then running addNode
  keeps it one operation with one log. profile_federate_later turns that off
  for a site whose deployment manager is built by someone else.

  THIS IS THE ROLE'S DEFAULT. An inventory supplies its own with
  profile_node_responsefile_template, and adds or overrides single keys with
  profile_node_extra_options without touching any template.
#}
{% set _body %}
create
profileName={{ was_profile_name }}
profilePath={{ was_profile_path }}
templatePath={{ was_home }}/profileTemplates/managed
nodeName={{ was_node_name }}
hostName={{ profile_node_hostname }}
{% if profile_node_ports | length > 0 %}
portsFile={{ profile_response_dir }}/ports.{{ was_node_name }}
{% elif was_base_port | default('') | string | length > 0 %}
startingPort={{ was_base_port }}
{% else %}
{#
  No port map and no base port: the product's own defaults - 9060 and 9043
  for a deployment manager's console, 8879 for its SOAP connector. What a
  machine that carries one profile of each kind wants.
#}
defaultPorts=true
{% endif %}
{% if profile_federate_later | bool %}
federateLater=true
{#
  An unfederated managed profile still needs a cell name of its own; it is
  replaced by the deployment manager's cell when the node is added later.
#}
cellName={{ was_cell_name }}
{% else %}
federateLater=false
dmgrHost={{ profile_dmgr_host }}
dmgrPort={{ profile_dmgr_soap_port }}
{% if profile_dmgr_admin_security | default(true) | bool %}
dmgrAdminUserName={{ was_admin_user }}
dmgrAdminPassword={{ was_admin_password }}
{% endif %}
{% endif %}
{% endset %}
{#
  The inventory's extra keys: one already written above is REPLACED in place,
  a new one is appended - never a key twice.
#}
{% set ns = namespace(body=_body) %}
{% for key, value in (profile_node_extra_options | default({})) | dictsort %}
{%   if ns.body is search('(?m)^' ~ (key | regex_escape) ~ '=') %}
{%     set ns.body = ns.body | regex_replace('(?m)^' ~ (key | regex_escape) ~ '=.*$', key ~ '=' ~ value) %}
{%   else %}
{%     set ns.body = ns.body ~ key ~ '=' ~ value ~ '\n' %}
{%   endif %}
{% endfor %}
{{ ns.body }}
